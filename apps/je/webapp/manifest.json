{
  "_version": "1.60.0",
  "sap.app": {
    "id": "gaon.je",
    "type": "application",
    "i18n": { "bundleUrl": "i18n/i18n.properties", "supportedLocales": [""], "fallbackLocale": "" },
    "applicationVersion": { "version": "1.0.0" },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "acdoca": { "uri": "model/acdoca.json", "type": "JSON" }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": false }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.2",
      "libs": { "sap.m": {}, "sap.ui.core": {}, "sap.f": {}, "sap.ui.table": {}, "sap.ui.layout": {} }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "models": {
      "i18n": { "type": "sap.ui.model.resource.ResourceModel", "settings": { "bundleName": "gaon.je.i18n.i18n", "supportedLocales": [""], "fallbackLocale": "" } },
      "": { "dataSource": "acdoca", "settings": { "defaultBindingMode": "OneWay" } }
    },
    "resources": { "css": [ { "uri": "css/style.css" } ] },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "type": "View",
        "viewType": "XML",
        "path": "gaon.je.view",
        "async": true
      },
      "routes": [ { "name": "main", "pattern": ":?query:", "target": ["main"] } ],
      "targets": { "main": { "id": "Main", "name": "Main" } }
    },
    "rootView": { "viewName": "gaon.je.view.App", "type": "XML", "id": "App", "async": true }
  }
}
